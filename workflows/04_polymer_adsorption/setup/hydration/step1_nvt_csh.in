# ===========================================================================
#  STEP 1: NVT equilibration of C-S-H nanofoil
#          Periodic in xy, vacuum in z (slab geometry)
# ===========================================================================
# Uses kspace_modify slab for 2D-periodic Ewald correction (Yeh-Berkowitz).
# The z-box is expanded to add ~50 A vacuum on each side of the slab.
# Adjust vacuum size and run length as needed.
# ===========================================================================

units          real
atom_style     full
boundary       p p f        # non-periodic z required for slab PPPM in recent LAMMPS

# ---- Read C-S-H data ----
read_data      csh_AT.data

# ---- Expand z-box to create vacuum ----
# CSH slab spans z ~ [-83, -35].  Add ~50 A vacuum on each side.
change_box all z final -135.0 15.0

# Reflecting walls at z-box edges to prevent atom loss (boundary p p f)
fix            zwall all wall/reflect zlo EDGE zhi EDGE

# ---- Groups ----
group Ca   type 1          # casl
group Si   type 2          # sc2
group O    type 3          # oc13
group Ob   type 4          # oc12
group Ow   type 5          # O* (CSH water)
group Hw   type 6          # H* (CSH water)
group Ohs  type 7          # oc14
group Hos  type 8          # hoy
group Oh   type 9          # Oh
group Ho   type 10         # Ho

# NOTE: The data file already contains per-atom charges (some Ca = 1.5,
# others = 1.7, etc.). The 'set' commands below would overwrite ALL atoms
# of each type with a single value.  They are commented out so the original
# per-atom charges are preserved.  Uncomment ONLY if you intentionally want
# uniform charges per type.
#
set group Ca   charge +1.7
set group Si   charge +1.0
set group O    charge -1.1
set group Ob   charge -0.5
set group Ow   charge -0.82
set group Hw   charge +0.41
set group Oh   charge -1.32
set group Ho   charge +0.47
set group Ohs  charge -0.67
set group Hos  charge +0.42

# ---- Force-field styles ----
pair_style     lj/cut/coul/long 12.0
pair_modify    mix geometric tail no
kspace_style   pppm 1.0e-5
kspace_modify  slab 3.0      # 2D slab correction for z-vacuum

special_bonds  lj/coul 0 0 1

# ---- Pair Coeffs (CSH) ----
pair_coeff 1  1    0.2900000000   2.9845107058   # casl
pair_coeff 2  2    0.4400000000   3.8451188675   # sc2
pair_coeff 3  3    0.0450000000   3.3096887379   # oc13
pair_coeff 4  4    0.0450000000   3.3096887379   # oc12
pair_coeff 5  5    0.1554164124   3.1655200879   # Ow (CSH)
pair_coeff 6  6    0.0000000000   0.0000000000   # Hw (CSH)
pair_coeff 7  7    0.1220000000   3.0914185538   # Ohs
pair_coeff 8  8    0.0159969724   0.9666649776   # Hos
pair_coeff 9  9    0.4000000000   3.1003300000   # Oh
pair_coeff 10 10   0.0000000000   0.0000000000   # Ho

# ---- Bond Coeffs ----
bond_style     harmonic
bond_coeff 1   350.0000   1.6200   # Si-O (CSH)
bond_coeff 2   350.0000   1.7000   # Si-Ob
bond_coeff 3   540.6336   0.9600   # O*-H* (CSH water)
bond_coeff 4   350.0000   1.6400   # Si-Ohs
bond_coeff 5   495.0000   0.9450   # Ohs-Hos
bond_coeff 6   520.0000   0.8850   # Oh-Ho

# ---- Angle Coeffs ----
angle_style    harmonic
angle_coeff 1  100.0000   109.4700   # Ob-Si-O
angle_coeff 2  100.0000   109.4700   # O-Si-O
angle_coeff 3  100.0000   141.5000   # Si-Ob-Si
angle_coeff 4   50.0000   104.5000   # H-O-H (CSH water)
angle_coeff 5  100.0000   109.4700   # Ob-Si-Ob
angle_coeff 6  100.0000   109.4700   # Ob-Si-Ohs
angle_coeff 7  100.0000   109.4700   # O-Si-Ohs
angle_coeff 8   50.0000   115.0000   # Si-Ohs-Hos

# ---- Minimisation (optional but recommended) ----
thermo         500
thermo_style   custom step temp pe ke etotal press lx ly lz

minimize       1.0e-6 1.0e-8 10000 100000

# ---- Velocity initialisation ----
velocity       all create 300.0 12345 dist gaussian

# ---- NVT equilibration ----
fix            nvt_csh all nvt temp 300.0 300.0 100.0
timestep       1.0

dump           1 all custom 5000 step1_nvt.lammpstrj id mol type q x y z
dump_modify    1 sort id

run            50000         # 50 ps  — adjust as needed

undump         1
unfix          nvt_csh
unfix          zwall

# ---- Save equilibrated configuration ----
write_data     step1_equilibrated.data
write_restart  step1.restart

print "=== Step 1 complete: C-S-H nanofoil NVT equilibrated ==="