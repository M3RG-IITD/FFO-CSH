group Ca type 1
group Si type 2
group O type 3
group Ow type 4
group Oh type 5
group Hw type 6
group Ho type 7
group Ohs type 8
group Hos type 9
group Ob type 10

set group Ca charge +1.7
set group Si charge +1.0
set group O charge -1.1
set group Ow charge -0.82    
set group Oh charge -1.32
set group Hw charge +0.41   
set group Ho charge +0.47    
set group Ohs charge -0.67
set group Hos charge +0.42
set group Ob charge -0.5

# =========================
# STYLES (PCFF)
# =========================

pair_style lj/class2/coul/long 12.0
pair_modify mix sixthpower
kspace_style ewald 1e-6

bond_style class2
angle_style class2
# dihedral_style class2
# improper_style class2

special_bonds lj/coul 0 0 1

# =========================
# PAIR COEFFS (mapped)
# =========================

pair_coeff 1 1 0.2400 3.5500   # Ca
pair_coeff 2 2 0.2941 4.7726   # Si  ← UPDATED
pair_coeff 3 3 0.1121 3.5697   # O   ← UPDATED
