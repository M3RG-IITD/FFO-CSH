# Remember that LAMMPS 2005 uses only single words as commands, e.g. bond_style
# This script is for lmp_linux executable (2011 64 bit)

# (1) Initialization
units			real
dimension		3
boundary		p p p
newton			on
atom_style		full
#processors		2 2 2

#kspace_style	pppm 1.0e-6
kspace_style ewald 1e-6
pair_style		lj/cut/coul/long 12.0

bond_style		harmonic
angle_style		harmonic
dihedral_style	harmonic
improper_style	cvff
box tilt large

# (2) Atom definition: 
read_data		T14_CVFF.data
# read_restart	sys.restart

# (3) Write coefficients separately
write_coeff T14_CVFF.params

# # (3) Settings
# neighbor		2.0 bin
# # neigh_modify   delay 10 every 10 check yes
# special_bonds	lj/coul 0.0 0.0 1.0
# change_box      all triclinic 

