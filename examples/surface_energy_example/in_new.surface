# LAMMPS script for surface energy calculation - (001) surface in z direction
# (1) Initialization
units real
dimension 3
boundary p p p       # Keep periodic boundary conditions in all directions
newton on
atom_style full
#processors 2 2 2
#kspace_style pppm 1.0e-6
kspace_style ewald 1e-6
pair_style lj/cut/coul/long 12.0
bond_style harmonic
angle_style harmonic
dihedral_style harmonic
improper_style cvff
box tilt large

# (2) Atom definition:
read_data T14_CVFF.data
# read_restart sys.restart

# Create vacuum above the slab in z direction
change_box all z scale 5.0 remap    # Scale z-dimension by 5 to create large vacuum

write_data surface_after_zscale.data

# # (3) Settings
# neighbor 2.0 bin
# # neigh_modify delay 10 every 10 check yes
# special_bonds lj/coul 0.0 0.0 1.0
