# LAMMPS coeff file via write_coeff, version 5 Jun 2019
pair_style lj/cut/coul/long 12.0
pair_modify	mix arithmetic tail yes
kspace_style  ewald 1e-6

bond_style harmonic
angle_style harmonic
dihedral_style harmonic

# Define special bonds
special_bonds	lj/coul 0 0 1

# pair_style lj/cut/coul/long
pair_coeff 1 1 0.19 3.38542
pair_coeff 2 2 0.155416 3.16552
pair_coeff 3 3 0.29 3.02906
pair_coeff 4 4 0.51 4.05359
pair_coeff 5 5 0.51 4.05359
pair_coeff 6 6 0.16 3.02906
pair_coeff 7 7 0.14 2.7796
pair_coeff 8 8 0.12 3.09142
pair_coeff 9 9 0.015997 0.966665
pair_coeff 10 10 0 0
pair_coeff 11 11 0.29 2.89542

# bond_style harmonic
bond_coeff 1 430 1.59
bond_coeff 2 540.634 0.96
bond_coeff 3 300 1.71
bond_coeff 4 300 1.62
bond_coeff 5 300 1.67
bond_coeff 6 430 1.68
bond_coeff 7 495 0.945

# angle_style harmonic
angle_coeff 1 50 104.5
angle_coeff 2 170 111.5
angle_coeff 3 170 100.2
angle_coeff 4 170 112.5
angle_coeff 5 170 107
angle_coeff 6 170 111
angle_coeff 7 170 111
angle_coeff 8 170 107
angle_coeff 9 170 139
angle_coeff 10 170 144
angle_coeff 11 50 115

# dihedral_style harmonic
dihedral_coeff 1 0 1 3
dihedral_coeff 2 0 1 3
dihedral_coeff 3 0 1 3
dihedral_coeff 4 0 1 3
dihedral_coeff 5 0 1 3
dihedral_coeff 6 0 1 3
dihedral_coeff 7 0 1 3
dihedral_coeff 8 0 1 3
dihedral_coeff 9 0 1 3

# improper_style cvff

